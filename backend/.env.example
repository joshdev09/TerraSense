# ── LocateAnything-3B (Hugging Face Inference Endpoint) ──────────────────────
# Get your token at: https://huggingface.co/settings/tokens
# The model: nvidia/LocateAnything-3B
HF_API_TOKEN=your_huggingface_token_here

# ── Optional: HuggingFace Inference Endpoint URL ─────────────────────────────
# If you deploy a dedicated endpoint instead of using the shared API:
HF_ENDPOINT_URL=https://api-inference.huggingface.co/models/nvidia/LocateAnything-3B

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
